## Copy these entries to local.properties and fill in your own values.
## Do not commit local.properties.
sdk.dir=C\:\\Users\\your-user\\AppData\\Local\\Android\\Sdk
YOUTUBE_API_KEY=

## OAuth 2.0 "Web application" client ID, only required if your backend
## verifies Google ID tokens. Do not put the Android OAuth client ID here.
GOOGLE_WEB_CLIENT_ID=
